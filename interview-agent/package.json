{
  "name": "interview-copilot-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local interview preparation and live transcription overlay",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --strictPort\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^9.0.0",
    "electron": "^45.3.0",
    "typescript": "^5.8.0",
    "vite": "^8.3.8",
    "wait-on": "^8.0.0"
  }
}
